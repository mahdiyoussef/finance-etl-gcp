GCP_PROJECT_ID=replace-me
FINANCE_ROOT=/opt/airflow/data/finance
FINANCE_REPORT_DATE=2026-01-31

# SQL Server Configuration (Operational / Staging Warehouse)
SQL_SERVER_ENDPOINT=localhost:1433
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=finance_db
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=YourStrong@Password123
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER_TRUST_CERTIFICATE=yes
# Optional direct connection URL override:
# DATABASE_URL=mssql+pyodbc://sa:YourStrong@Password123@localhost:1433/finance_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Required only for Terraform budget creation:
TF_VAR_billing_account_id=replace-me
